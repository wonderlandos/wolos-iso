    s = socket.socket(socket.AF_UNIX)
    s.connect(vm.p("serial.sock"))
    for ch in a.text.encode().decode("unicode_escape").replace("\n", "\r"):
        s.sendall(ch.encode("latin-1"))
        time.sleep(0.02)
    s.close()
    return 0


