"""wolvm: a QEMU test VM an agent (or a person) drives one step at a time, from ISO boot through
the installer, the reboot into the installed disk, login and the apps. Python 3 stdlib only.

  wolvm doctor                               KVM, QEMU, OVMF, swtpm, virt-fw-vars present?
  wolvm new NAME --iso X | --from-image DISK [--disk 40G] [--mem 6G] [--smp 4] [--tpm] [--secureboot]
            [--gpu virtio|vmsvga|std|qxl|virtio-gl | --virtio | --vmsvga] [--res 1280x800]
            [--ssh] [--direct] [--append ARGS] [--cred NAME=VALUE]... [--force]
            [--drive FILE[,ro|,snapshot]]... [--no-net] [--iso-bus ide|virtio]
  wolvm start NAME | stop NAME [--force] | status NAME | list | rm NAME
  wolvm set NAME [--boot disk|cdrom] [--iso X | --no-iso] [--append ARGS] [--mem M] [--gpu G]
            [--secureboot on|off] [--net on|off]
  wolvm eject NAME                           take the ISO out of the running VM
  wolvm screenshot NAME OUT.png              QMP screendump; prints "OUT.png WxH"
  wolvm wait-stable NAME [--timeout S]       until two screens 2 s apart are identical
  wolvm type NAME TEXT                       US keyboard; \\n in TEXT is Enter (use $'..' in sh)
  wolvm key NAME COMBO...                    ctrl-alt-t ret esc tab super f2 ... one combo per arg
  wolvm click NAME X Y [--button left|right|middle] [--double]   screen pixels (usb-tablet)
  wolvm serial NAME tail [-n N] | serial NAME send TEXT
  wolvm wait-text NAME TEXT [--timeout S] [--regex] [--new]      on the serial log
  wolvm wait-agent NAME [--timeout S]        until the QEMU guest agent answers
  wolvm ssh NAME CMD...                      sshd (--ssh VMs) or the guest agent: a root shell command
  wolvm ssh-open NAME                        --ssh VMs: start sshd + accept port 22 in the guest (this boot)
  wolvm logs NAME [-n N] [-u UNIT] [-o FILE] journal of the current boot (serial log as fallback)
  wolvm snapshot NAME save|restore|list|delete [TAG]   running: whole VM (savevm); stopped: disks
  wolvm journey NAME FILE [--out DIR] [--from N] [--keep-going]  replay steps, a screenshot each
  wolvm report DIR                           DIR/report.md + DIR/index.html for a human
Global: --dry-run (print the qemu command / QMP JSON, run nothing), --home DIR (or $WOLVM_HOME).
"""
import argparse, base64, json, os, re, shlex, shutil, socket, struct, subprocess, sys, time, zlib, html

HOME_DEFAULT = os.path.join(os.path.expanduser("~"), ".local", "share", "wolvm")
FW_DIRS = ["/usr/share/edk2/x64", "/usr/share/edk2-ovmf/x64", "/usr/share/OVMF/x64", "/usr/share/OVMF",
           "/usr/share/edk2/ovmf", "/usr/share/qemu"]
FW_CODE = ["OVMF_CODE.4m.fd", "OVMF_CODE_4M.fd", "OVMF_CODE.fd"]
FW_CODE_SB = ["OVMF_CODE.secboot.4m.fd", "OVMF_CODE_4M.secboot.fd", "OVMF_CODE.secboot.fd"]
FW_VARS = ["OVMF_VARS.4m.fd", "OVMF_VARS_4M.fd", "OVMF_VARS.fd"]
GPUS = {"virtio": ["-device", "virtio-vga,xres={x},yres={y}"],
        "virtio-gl": ["-device", "virtio-vga-gl,xres={x},yres={y}", "-display", "egl-headless"],
        "vmsvga": ["-device", "vmware-svga"], "std": ["-device", "VGA,xres={x},yres={y}"],
        "qxl": ["-device", "qxl-vga,xres={x},yres={y}"]}
DRY = False


def read_file(path, mode="r"):
    """The whole file, closed again (no handle left to the collector: python3 -X dev is quiet)."""
    with open(path, mode) as f:
        return f.read()


def write_file(path, data, mode="w"):
    with open(path, mode) as f:
        f.write(data)


def die(msg, code=1):
    sys.stderr.write(f"wolvm: {msg}\n")
    sys.exit(code)


# ---------------------------------------------------------------- keys and input (pure builders)
KEY_ALIAS = {"enter": "ret", "return": "ret", "space": "spc", "escape": "esc", "bksp": "backspace",
             "bs": "backspace", "del": "delete", "super": "meta_l", "win": "meta_l", "meta": "meta_l",
             "control": "ctrl", "ctl": "ctrl", "altgr": "alt_r", "pageup": "pgup", "pagedown": "pgdn",
             "ins": "insert", "printscreen": "print", "menu": "compose"}
# Unshifted and shifted characters of a US layout -> QEMU qcodes (same table as tests/test/qmp.py).
CHAR_KEY = {" ": "spc", "\n": "ret", "=": "equal", ",": "comma", ".": "dot", "/": "slash", "-": "minus",
            ";": "semicolon", "'": "apostrophe", "[": "bracket_left", "]": "bracket_right", "\t": "tab",
            "`": "grave_accent", "\\": "backslash"}
SHIFT_KEY = {'"': "apostrophe", "_": "minus", ":": "semicolon", "|": "backslash", ">": "dot", "<": "comma",
             "*": "8", "$": "4", "&": "7", "(": "9", ")": "0", "~": "grave_accent", "!": "1", "#": "3",
             "{": "bracket_left", "}": "bracket_right", "?": "slash", "+": "equal", "@": "2", "%": "5",
             "^": "6"}


def combo_keys(combo):
    """'ctrl-alt-t' -> ['ctrl','alt','t']; a lone '-' is the minus key."""
    if combo in ("-", "minus"):
        return ["minus"]
    out = []
    for k in combo.lower().split("-"):
        if not k:
            raise ValueError(f"bad key combo {combo!r}")
        out.append(KEY_ALIAS.get(k, k))
    return out


def text_keys(text):
    """Text -> list of key chords (each a list of qcodes)."""
    chords = []
    for ch in text:
        if ch == "\r":
            continue
        if ch in CHAR_KEY:
            chords.append([CHAR_KEY[ch]])
        elif ch in SHIFT_KEY:
            chords.append(["shift", SHIFT_KEY[ch]])
        elif ch.isascii() and ch.isalpha():
            chords.append(["shift", ch.lower()] if ch.isupper() else [ch])
        elif ch.isascii() and ch.isdigit():
            chords.append([ch])
        else:
            raise ValueError(f"no US key for {ch!r}")
    return chords


def qmp_send_key(chord, hold_ms=40):
    return {"execute": "send-key",
            "arguments": {"keys": [{"type": "qcode", "data": k} for k in chord], "hold-time": hold_ms}}


def qmp_abs_move(x, y, w, h):
    sx = max(0, min(32767, x * 32767 // max(1, w - 1)))
    sy = max(0, min(32767, y * 32767 // max(1, h - 1)))
    return {"execute": "input-send-event", "arguments": {"events": [
        {"type": "abs", "data": {"axis": "x", "value": sx}},
        {"type": "abs", "data": {"axis": "y", "value": sy}}]}}


def qmp_button(button, down):
    return {"execute": "input-send-event",
            "arguments": {"events": [{"type": "btn", "data": {"button": button, "down": down}}]}}


def qmp_screendump(path, fmt="png"):
    a = {"filename": path}
    if fmt != "ppm":
        a["format"] = fmt
    return {"execute": "screendump", "arguments": a}


def qmp_hmp(line):
    return {"execute": "human-monitor-command", "arguments": {"command-line": line}}


def qemu_escape(v):
    """A value inside a -opt k=v,k=v string: commas are doubled."""
    return str(v).replace(",", ",,")


# ---------------------------------------------------------------- images (stdlib PNG)
def ppm_to_png(ppm_bytes):
    m = re.match(rb"P6\s+(\d+)\s+(\d+)\s+(\d+)\s", ppm_bytes)
    if not m:
        raise ValueError("not a P6 PPM")
    w, h = int(m.group(1)), int(m.group(2))
    px = ppm_bytes[m.end():m.end() + w * h * 3]
    raw = b"".join(b"\x00" + px[r * w * 3:(r + 1) * w * 3] for r in range(h))

    def chunk(t, d):
        return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xffffffff)
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b"")), (w, h)


def png_size(path):
    with open(path, "rb") as f:
        head = f.read(24)
    if head[:8] != b"\x89PNG\r\n\x1a\n":
        raise ValueError(f"{path}: not a PNG")
    return struct.unpack(">II", head[16:24])


# ---------------------------------------------------------------- journey steps
VERBS = {  # verb -> how its argument string splits: "one" (whole), "words", "none"
    "start": "none", "stop": "none", "shot": "one", "screenshot": "one", "type": "one", "key": "words",
    "click": "words", "wait-text": "one", "wait-agent": "none", "wait-stable": "none", "sleep": "one",
    "ssh": "one", "exec": "one", "logs": "none", "checkpoint": "one", "snapshot-save": "one",
    "snapshot-restore": "one", "eject": "none", "boot": "one", "note": "one", "serial-send": "one",
}


def _unquote(s):
    s = s.strip()
    if len(s) >= 2 and s[0] == s[-1] == '"':
        return json.loads(s)
    if len(s) >= 2 and s[0] == s[-1] == "'":
        return s[1:-1].replace("''", "'")
    return s


def _scalar(s):
    s = s.strip()
    if s[:1] in ("'", '"'):
        return _unquote(s)
    if re.fullmatch(r"-?\d+", s):
        return int(s)
    if re.fullmatch(r"-?\d+\.\d*", s):
        return float(s)
    if s in ("true", "false"):
        return s == "true"
    if s in ("", "null", "~"):
        return None
    return s


def parse_step(item):
    """A step is "verb args" or {verb: args, option: value...}. Returns {verb, args, opts}."""
    if isinstance(item, str):
        verb, _, rest = item.strip().partition(" ")
        opts, arg = {}, rest
    elif isinstance(item, dict):
        verb = next(iter(item), None)  # the first key is the verb; "shot: false" may follow
        if verb not in VERBS:
            raise ValueError(f"step must start with a verb of {sorted(VERBS)}: {item!r}")
        arg = item[verb]
        opts = {k: v for k, v in item.items() if k != verb}
    else:
        raise ValueError(f"bad step {item!r}")
    if verb not in VERBS:
        raise ValueError(f"unknown verb {verb!r} (known: {', '.join(sorted(VERBS))})")
    kind = VERBS[verb]
    if arg is None or arg == "":
        args = []
    elif isinstance(arg, list):
        args = [str(a) for a in arg]
    elif kind == "words":
        args = str(arg).split()
    elif isinstance(item, str):
        args = [_unquote(arg)]
    else:
        args = [str(arg)]
    if kind in ("one", "words") and not args and verb not in ("shot", "screenshot", "checkpoint", "boot"):
        raise ValueError(f"{verb}: needs an argument")
    return {"verb": verb, "args": args, "opts": opts}


def parse_yaml_steps(text):
    """The YAML subset journeys use: optional top-level 'key: value' lines, then '- step' items,
    each either '- verb args' or '- verb: value' with indented 'option: value' lines under it."""
    meta, items, cur = {}, [], None
    for n, line in enumerate(text.splitlines(), 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        s = line.strip()
        if s.startswith("- ") or s == "-":
            body = s[1:].strip()
            m = re.match(r"^([A-Za-z][\w-]*):(?:\s+(.*))?$", body)
            if m and m.group(1) in VERBS:
                cur = {m.group(1): _scalar(m.group(2) or "")}
                items.append(cur)
            else:
                cur = None
                items.append(body)
        elif line[:1] in (" ", "\t") and isinstance(cur, dict):
            m = re.match(r"^([A-Za-z][\w-]*):\s*(.*)$", s)
            if not m:
                raise ValueError(f"line {n}: expected 'option: value'")
            cur[m.group(1)] = _scalar(m.group(2))
        else:
            m = re.match(r"^([A-Za-z][\w-]*):\s*(.*)$", s)
            if not m:
                raise ValueError(f"line {n}: cannot parse {s!r}")
            if m.group(1) != "steps":
                meta[m.group(1)] = _scalar(m.group(2))
    return meta, items


def load_journey(path):
    with open(path, encoding="utf-8") as f:
        text = f.read()
    if text.lstrip()[:1] in ("[", "{"):
        data = json.loads(text)
        meta, items = ({}, data) if isinstance(data, list) else (
            {k: v for k, v in data.items() if k != "steps"}, data.get("steps", []))
    else:
        meta, items = parse_yaml_steps(text)
    return meta, [parse_step(i) for i in items]


# ---------------------------------------------------------------- VM config and qemu command
def find_fw(names, dirs=None):
    env = os.environ.get("WOLVM_OVMF")
    for d in ([env] if env else []) + (dirs or FW_DIRS):
        for n in names:
            p = os.path.join(d, n)
            if os.path.isfile(p):
                return p
    return None


def iso_label(path):
    """ISO 9660 volume id (primary volume descriptor at 32 KiB, bytes 40..72)."""
    with open(path, "rb") as f:
        f.seek(16 * 2048)
        pvd = f.read(2048)
    if pvd[1:6] != b"CD001":
        raise ValueError(f"{path}: not an ISO 9660 image")
    return pvd[40:72].decode("ascii", "replace").strip()


def default_append(cfg, live=True):
    """Extra kernel cmdline: the serial console for every boot (ISO and installed system), so
    wait-text, serial tail and logs work without changing the image; --append words only while the
    VM boots the ISO (wolos.autoinstall must never reach the installed system). systemd-boot and
    systemd-stub take it from SMBIOS type 11 (ignored with Secure Boot on)."""
    a = "console=tty0 console=ttyS0,115200" if cfg.get("console", True) else ""
    if live and cfg.get("append"):
        a = (a + " " + cfg["append"]).strip()
    return a


def qemu_cmd(cfg, d, run=None):
    """The full qemu-system-x86_64 argv for VM config cfg living in dir d."""
    run = run or {}
    p = lambda n: os.path.join(d, n)
    x, y = (cfg.get("res") or "1280x800").split("x")
    kvm = cfg.get("kvm", True)
    sb = cfg.get("secureboot", False)
    c = ["qemu-system-x86_64", "-name", f"wolvm-{cfg['name']}", "-machine", "q35" + (",smm=on" if sb else "")]
    c += ["-accel", "kvm", "-cpu", "host"] if kvm else ["-accel", "tcg,thread=multi", "-cpu", "max"]
    c += ["-smp", str(cfg.get("smp", 4)), "-m", str(cfg.get("mem", "6G"))]
    if sb:
        c += ["-global", "driver=cfi.pflash01,property=secure,value=on"]
    c += ["-drive", f"if=pflash,format=raw,readonly=on,file={qemu_escape(cfg['fw_code'])}",
          "-drive", f"if=pflash,format=qcow2,file={qemu_escape(p('vars.qcow2'))}"]
    disk_first = cfg.get("boot", "cdrom") == "disk" or not cfg.get("iso")
    direct = bool(cfg.get("iso") and cfg.get("direct") and not disk_first)
    # -kernel takes bootindex 0 itself (QEMU's linuxboot option ROM): then no bootindex at all.
    bi = (lambda n: "") if direct else (lambda n: f",bootindex={n}")
    c += ["-drive", f"file={qemu_escape(p('disk.qcow2'))},if=none,id=disk0,format=qcow2,discard=unmap",
          "-device", f"virtio-blk-pci,drive=disk0{bi(0 if disk_first else 1)}"]
    for n, (path, mode) in enumerate(split_drive(x) for x in cfg.get("drives", [])):
        # Extra disks as they are (raw, no conversion: tests compare their bytes): /dev/vdb, vdc...
        flags = {"ro": ",readonly=on", "snapshot": ",snapshot=on"}.get(mode, "")
        c += ["-drive", f"file={qemu_escape(path)},if=none,id=extra{n},format=raw{flags}",
              "-device", f"virtio-blk-pci,drive=extra{n}"]
    if cfg.get("iso") and cfg.get("iso_bus") == "virtio":
        # The ISO as a USB-stick-like disk: writable, changes thrown away at exit (snapshot=on).
        c += ["-drive", f"file={qemu_escape(cfg['iso'])},if=none,id=cdrom0,format=raw,snapshot=on",
              "-device", f"virtio-blk-pci,id=cd0,drive=cdrom0{bi(1 if disk_first else 0)}"]
    elif cfg.get("iso"):
        c += ["-drive", f"file={qemu_escape(cfg['iso'])},if=none,id=cdrom0,media=cdrom,readonly=on",
              "-device", f"ide-cd,id=cd0,drive=cdrom0{bi(1 if disk_first else 0)}"]
    if cfg.get("iso"):
        if direct:  # (inside: the ISO is attached)
            k = cfg["direct"]
            c += ["-kernel", k["kernel"], "-initrd", k["initrd"],
                  "-append", f"archisobasedir={k['basedir']} archisolabel={k['label']} {default_append(cfg)}".strip()]
    # Direct boot: the words are in -append already; SMBIOS only carries the console then.
    extra = default_append(cfg, live=bool(cfg.get("iso")) and not disk_first and not direct)
    if extra:  # systemd ignores it while Secure Boot is enforced; harmless then
        for key in ("io.systemd.boot.kernel-cmdline-extra", "io.systemd.stub.kernel-cmdline-extra"):
            c += ["-smbios", f"type=11,value={qemu_escape(key + '=' + extra)}"]
    for cred in cfg.get("creds", []):
        c += ["-smbios", f"type=11,value={qemu_escape('io.systemd.credential:' + cred)}"]
    c += [a.format(x=x, y=y) for a in GPUS[cfg.get("gpu", "virtio")]]
    if "-display" not in GPUS[cfg.get("gpu", "virtio")]:
        c += ["-display", "none"]
    if cfg.get("vnc"):
        c += ["-vnc", cfg["vnc"]]
    c += ["-device", "qemu-xhci", "-device", "usb-tablet"]
    if cfg.get("net", True):
        nic = "user,model=virtio-net-pci"
        if run.get("ssh_port"):
            nic += f",hostfwd=tcp:127.0.0.1:{run['ssh_port']}-:22"
        c += ["-nic", nic]
    else:
        c += ["-nic", "none"]
    c += ["-qmp", f"unix:{p('qmp.sock')},server=on,wait=off",
          "-chardev", f"socket,id=ser0,path={p('serial.sock')},server=on,wait=off,logfile={p('serial.log')},logappend=on",
          "-serial", "chardev:ser0",
          "-chardev", f"socket,id=qga0,path={p('qga.sock')},server=on,wait=off",
          "-device", "virtio-serial-pci", "-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"]
    if cfg.get("tpm"):
        c += ["-chardev", f"socket,id=tpmc,path={p('tpm.sock')}", "-tpmdev", "emulator,id=tpm0,chardev=tpmc",
              "-device", "tpm-tis,tpmdev=tpm0"]
    c += ["-daemonize", "-pidfile", p("qemu.pid")]
    return c


def split_drive(spec):
    """'FILE', 'FILE,ro' or 'FILE,snapshot' -> (FILE, mode)."""
    path, _, mode = spec.rpartition(",") if spec.endswith((",ro", ",snapshot")) else (spec, "", "")
    return path, mode


def vars_secureboot_cmds(vars_qcow2, on, tmp):
    """qemu-img + virt-fw-vars argv list that flips SecureBootEnable in a qcow2 vars file."""
    raw, out = tmp + ".raw", tmp + ".sb.raw"
    return [["qemu-img", "convert", "-f", "qcow2", "-O", "raw", vars_qcow2, raw],
            ["virt-fw-vars", "--input", raw, "--output", out, "--set-true" if on else "--set-false", "SecureBootEnable"],
            ["qemu-img", "convert", "-f", "raw", "-O", "qcow2", out, vars_qcow2]]


def swtpm_cmd(d):
    return ["swtpm", "socket", "--tpm2", "--tpmstate", f"dir={os.path.join(d, 'tpm')}",
            "--ctrl", f"type=unixio,path={os.path.join(d, 'tpm.sock')}", "--daemon", "--terminate",
            "--pid", f"file={os.path.join(d, 'swtpm.pid')}", "--log", f"file={os.path.join(d, 'swtpm.log')}"]


# ---------------------------------------------------------------- QMP / guest agent clients
class Qmp:
    def __init__(self, sock_path, timeout=30):
        if DRY:
            self.f = None
            return
        if not os.path.exists(sock_path):
            die(f"{sock_path}: not running (wolvm start)")
        self.s = socket.socket(socket.AF_UNIX)
        self.s.settimeout(timeout)
        self.s.connect(sock_path)
        self.f = self.s.makefile("rw")
        self.f.readline()
        self.call({"execute": "qmp_capabilities"})

    def call(self, msg):
        if DRY:
            print(json.dumps(msg))
            return {}
        self.f.write(json.dumps(msg) + "\n")
        self.f.flush()
        while True:
            line = self.f.readline()
            if not line:
                die("QMP closed the connection")
            r = json.loads(line)
            if "error" in r:
                raise RuntimeError(f"{msg['execute']}: {r['error'].get('desc')}")
            if "return" in r:
                return r["return"]

    def hmp(self, line):
        out = self.call(qmp_hmp(line))
        return out if isinstance(out, str) else ""


class Agent:
    """QEMU guest agent (qemu-guest-agent runs in the ISO and the installed system)."""

    def __init__(self, sock_path, timeout=10):
        self.s = socket.socket(socket.AF_UNIX)
        self.s.settimeout(timeout)
        self.s.connect(sock_path)
        self.f = self.s.makefile("rwb")
        sync = int(time.time() * 1000) % 2147483647
        self.f.write(b"\xff" + json.dumps({"execute": "guest-sync-delimited", "arguments": {"id": sync}}).encode() + b"\n")
        self.f.flush()
        while True:  # skip stale replies until ours
            line = self.f.readline()
            if not line:
                raise OSError("guest agent closed")
            line = line.lstrip(b"\xff").strip()
            if not line:
                continue
            try:
                if json.loads(line).get("return") == sync:
                    break
            except ValueError:
                continue

    def call(self, cmd, **args):
        self.f.write(json.dumps({"execute": cmd, **({"arguments": args} if args else {})}).encode() + b"\n")
        self.f.flush()
        r = json.loads(self.f.readline())
        if "error" in r:
            raise RuntimeError(f"{cmd}: {r['error'].get('desc')}")
        return r.get("return")

    def run(self, shell_cmd, timeout=300):
        pid = self.call("guest-exec", path="/bin/sh", arg=["-c", shell_cmd], **{"capture-output": True})["pid"]
        end = time.time() + timeout
        while time.time() < end:
            st = self.call("guest-exec-status", pid=pid)
            if st.get("exited"):
                dec = lambda k: base64.b64decode(st.get(k, "")).decode("utf-8", "replace")
                return st.get("exitcode", -1), dec("out-data"), dec("err-data")
            time.sleep(0.3)
        raise TimeoutError(f"guest command still running after {timeout} s")


# ---------------------------------------------------------------- the VM
class VM:
    def __init__(self, home, name):
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,40}", name):
            die(f"bad VM name {name!r}")
        self.name, self.dir = name, os.path.join(home, "vms", name)
        self.cfg_path, self.run_path = self.p("vm.json"), self.p("run.json")

    def p(self, n):
        return os.path.join(self.dir, n)

    @property
    def cfg(self):
        if not os.path.exists(self.cfg_path):
            die(f"no VM {self.name!r} (wolvm new {self.name} --iso ...)")
        with open(self.cfg_path) as f:
            return json.load(f)

    def save_cfg(self, cfg):
        with open(self.cfg_path + ".tmp", "w") as f:
            json.dump(cfg, f, indent=1)
        os.replace(self.cfg_path + ".tmp", self.cfg_path)

    @property
    def run(self):
        try:
            with open(self.run_path) as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}

    def save_run(self, run):
        with open(self.run_path, "w") as f:
            json.dump(run, f)

    def pid(self):
        try:
            pid = int(read_file(self.p("qemu.pid")).strip())
            os.kill(pid, 0)
            return pid
        except (OSError, ValueError):
            return None

    def qmp(self):
        return Qmp(self.p("qmp.sock"))

    def agent(self, timeout=10):
        return Agent(self.p("qga.sock"), timeout)


def sh(cmd, **kw):
    if DRY:
        print(shlex.join(cmd))
        return subprocess.CompletedProcess(cmd, 0, "", "")
    return subprocess.run(cmd, text=True, capture_output=True, stdin=subprocess.DEVNULL, **kw)


def extract_direct(iso, d):
    """Kernel + initramfs out of an archiso image, for --direct (cmdline under our control)."""
    names = subprocess.run(["bsdtar", "-tf", iso], text=True, capture_output=True, check=True).stdout.split()
    kern = next((n for n in names if re.search(r"(^|/)boot/x86_64/vmlinuz-[^/]+$", n)), None)
    if not kern:
        die(f"{iso}: no boot/x86_64/vmlinuz-* (not an archiso image?)")
    base = kern.split("/boot/")[0]
    flavour = kern.rsplit("vmlinuz-", 1)[1]
    init = f"{base}/boot/x86_64/initramfs-{flavour}.img"
    if init not in names:
        die(f"{iso}: no {init}")
    out = {}
    for key, member in (("kernel", kern), ("initrd", init)):
        dst = os.path.join(d, os.path.basename(member))
        with open(dst, "wb") as f:
            subprocess.run(["bsdtar", "-xOf", iso, member], stdout=f, check=True)
        out[key] = dst
    out["basedir"], out["label"] = base, iso_label(iso)
    return out


def cmd_new(a):
    vm = VM(a.home, a.name)
    if os.path.exists(vm.cfg_path):
        if not a.force:
            die(f"{vm.name} exists (--force replaces it)")
        if vm.pid():
            die(f"{vm.name} is running; stop it first")
        if not DRY:
            shutil.rmtree(vm.dir)
    gpu = "vmsvga" if a.vmsvga else "virtio" if a.virtio else a.gpu
    fw_code = find_fw(FW_CODE_SB if a.secureboot else FW_CODE)
    fw_vars = find_fw(FW_VARS)
    if not fw_code or not fw_vars:
        die("no OVMF firmware found (pacman -S edk2-ovmf, or set WOLVM_OVMF=dir)")
    iso = os.path.abspath(a.iso) if a.iso else None
    if a.from_image and not os.path.isfile(a.from_image):
        die(f"{a.from_image}: no such disk image")
    if iso and not os.path.isfile(iso):
        die(f"{iso}: no such ISO")
    cfg = {"name": vm.name, "iso": iso, "disk": a.disk, "mem": a.mem, "smp": a.smp, "tpm": a.tpm,
           "secureboot": a.secureboot, "gpu": gpu, "res": a.res, "boot": "cdrom" if iso else "disk",
           "append": a.append or "", "creds": list(a.cred or []), "ssh": a.ssh, "fw_code": fw_code,
           "kvm": os.access("/dev/kvm", os.R_OK | os.W_OK), "vnc": a.vnc, "console": not a.no_console,
           "drives": [f"{os.path.abspath(p)}{(',' + m) if m else ''}" for p, m in (split_drive(x) for x in a.drive or [])],
           "net": not a.no_net, "iso_bus": a.iso_bus}
    for path, _ in (split_drive(x) for x in cfg["drives"]):
        if not os.path.isfile(path) and not DRY:
            die(f"--drive {path}: no such file")
    if DRY:
        print(json.dumps(cfg, indent=1))
        print(shlex.join(qemu_cmd(cfg, vm.dir, {"ssh_port": 2222 if a.ssh else None})))
        return 0
    os.makedirs(os.path.join(vm.dir, "shots"), exist_ok=True)
    if a.from_image:  # an existing disk (raw or qcow2): an installed system, a prepared ESP
        r = sh(["qemu-img", "convert", "-O", "qcow2", os.path.abspath(a.from_image), vm.p("disk.qcow2")])
        if not r.returncode:
            sh(["qemu-img", "resize", "-q", vm.p("disk.qcow2"), a.disk])  # grow only; a smaller size fails harmlessly
    else:
        r = sh(["qemu-img", "create", "-q", "-f", "qcow2", vm.p("disk.qcow2"), a.disk])
    if r.returncode:
        die(r.stderr.strip())
    vars_src = fw_vars
    if a.secureboot:
        tmp = vm.p("vars-sb.fd")
        r = sh(["virt-fw-vars", "--input", fw_vars, "--output", tmp, "--enroll-redhat", "--secure-boot"])
        if r.returncode:
            die("--secureboot needs virt-fw-vars (pacman -S virt-firmware): " + r.stderr.strip()[-300:])
        vars_src = tmp
    r = sh(["qemu-img", "convert", "-f", "raw", "-O", "qcow2", vars_src, vm.p("vars.qcow2")])
    if r.returncode:
        die(r.stderr.strip())
    if a.ssh:
        key = vm.p("id_ed25519")
        sh(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", f"wolvm-{vm.name}", "-f", key], check=True)
        pub = read_file(key + ".pub").strip()
        cfg["creds"].append("ssh.authorized_keys.root=" + pub)
    if a.direct:
        if not iso:
            die("--direct needs --iso")
        cfg["direct"] = extract_direct(iso, vm.dir)
    vm.save_cfg(cfg)
    print(f"{vm.name}: {vm.dir} ({a.disk} disk, {gpu}, tpm={a.tpm}, secureboot={a.secureboot}, kvm={cfg['kvm']})")
    return 0


def free_port():
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()
    return port


def cmd_start(a):
    vm = VM(a.home, a.name)
    cfg = vm.cfg
    if vm.pid():
        print(f"{vm.name}: already running (pid {vm.pid()})")
        return 0
    run = {"ssh_port": (free_port() if not DRY else 2222) if cfg.get("ssh") else None}
    if cfg.get("tpm"):
        if not DRY:
            os.makedirs(vm.p("tpm"), exist_ok=True)
        r = sh(swtpm_cmd(vm.dir))
        if r.returncode:
            die("swtpm: " + r.stderr.strip())
        for _ in range(50):
            if DRY or os.path.exists(vm.p("tpm.sock")):
                break
            time.sleep(0.1)
    cmd = qemu_cmd(cfg, vm.dir, run)
    if DRY:
        print(shlex.join(cmd))
        return 0
    for s in ("qmp.sock", "serial.sock", "qga.sock"):
        if os.path.exists(vm.p(s)):
            os.remove(vm.p(s))
    run["serial_offset"] = os.path.getsize(vm.p("serial.log")) if os.path.exists(vm.p("serial.log")) else 0
    run["started"] = time.time()
    vm.save_run(run)
    with open(vm.p("qemu.log"), "a") as log:
        log.write(f"--- {time.ctime()}\n{shlex.join(cmd)}\n")
        log.flush()
        # stdin from /dev/null: a daemonized qemu must not hold the caller's terminal or ssh session
        r = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=log, stderr=log)
    if r.returncode:
        try:  # a swtpm nobody connected to does not end by itself
            os.kill(int(read_file(vm.p("swtpm.pid")).strip()), 15)
        except (OSError, ValueError):
            pass
        last = read_file(vm.p("qemu.log")).strip().splitlines()[-1:]
        die(f"qemu failed (exit {r.returncode}): {last[0] if last else ''} ({vm.p('qemu.log')})")
    print(f"{vm.name}: started pid {vm.pid()}" + (f", ssh port {run['ssh_port']}" if run.get("ssh_port") else ""))
    return 0


def cmd_stop(a):
    vm = VM(a.home, a.name)
    pid = vm.pid()
    if not pid and not DRY:
        print(f"{vm.name}: not running")
        return 0
    if DRY:
        q = vm.qmp()
        if not a.force:
            q.call({"execute": "system_powerdown"})
        q.call({"execute": "quit"})
        return 0
    if not a.force:
        # A guest that powered itself off (install-auto waits for "reboot: Power down") leaves a
        # dying QEMU: its monitor refuses, resets or closes. That is "already going down", not an
        # error: skip the powerdown and just wait for the pid to go.
        try:
            vm.qmp().call({"execute": "system_powerdown"})
        except (OSError, SystemExit) as e:
            print(f"{vm.name}: monitor gone ({e.__class__.__name__}), guest already going down")
        end = time.time() + a.timeout
        while time.time() < end and vm.pid():
            time.sleep(0.5)
    if vm.pid():
        try:
            vm.qmp().call({"execute": "quit"})
        except (OSError, RuntimeError, SystemExit):
            pass
        time.sleep(1)
    if vm.pid():
        os.kill(pid, 9)
    print(f"{vm.name}: stopped")
    return 0


def nudge(vm, q):
    """Hyprland on virtio-vga without GL only flushes damaged regions; until something changes the
    scanout can stay an old frame (seen on the v0.11.5 installer: black for 30 s, whole after one
    pointer move). Moving the pointer one pixel and back makes it repaint, without a click."""
    run = vm.run
    w, h = run.get("screen") or (1280, 800)
    x, y = run.get("pointer") or (w // 2, h // 2)
    q.call(qmp_abs_move(x + 1 if x + 1 < w else x - 1, y, w, h))
    q.call(qmp_abs_move(x, y, w, h))
    if not DRY:
        time.sleep(0.4)


def screenshot(vm, out, do_nudge=True):
    out = os.path.abspath(out)
    q = vm.qmp()
    if do_nudge:
        nudge(vm, q)
    if DRY:
        q.call(qmp_screendump(out))
        return 0, 0
    os.makedirs(os.path.dirname(out), exist_ok=True)
    if os.path.exists(out):
        os.remove(out)
    try:
        q.call(qmp_screendump(out, "png"))
    except RuntimeError as e:
        if "format" not in str(e).lower() and "png" not in str(e).lower():
            raise
        tmp = out + ".ppm"
        q.call(qmp_screendump(tmp, "ppm"))
        png, _ = ppm_to_png(read_file(tmp, "rb"))
        os.remove(tmp)
        write_file(out, png, "wb")
    size = png_size(out)
    run = vm.run
    run["screen"] = list(size)
    vm.save_run(run)
    return size


