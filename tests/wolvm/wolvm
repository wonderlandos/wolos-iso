def snapshot(vm, action, tag=None):
    running = vm.pid() is not None
    if action in ("save", "restore", "delete") and not tag:
        die(f"snapshot {action} needs a TAG")
    if running or DRY:
        hmp = {"save": f"savevm {tag}", "restore": f"loadvm {tag}", "delete": f"delvm {tag}",
               "list": "info snapshots"}[action]
        out = vm.qmp().hmp(hmp)
        if action != "list" and out.strip():
            die(f"{hmp}: {out.strip()}")
        return out or f"{action} {tag}: ok (whole VM)"
    flag = {"save": "-c", "restore": "-a", "delete": "-d", "list": "-l"}[action]
    out = []
    for disk in ("disk.qcow2", "vars.qcow2"):
        r = sh(["qemu-img", "snapshot", flag] + ([tag] if tag else []) + [vm.p(disk)])
        if r.returncode:
            die(f"qemu-img snapshot {flag} {disk}: {r.stderr.strip()}")
        out.append(r.stdout if action == "list" else f"{disk}: {action} {tag} ok (disks only, VM stopped)")
    return "\n".join(out)


