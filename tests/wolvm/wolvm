def wait_stable(vm, timeout, interval=2.0):
    q, last, end = vm.qmp(), None, time.time() + timeout
    tmp = vm.p("stable.ppm")
    while time.time() < end:
        nudge(vm, q)
        q.call(qmp_screendump(tmp, "ppm"))
        cur = read_file(tmp, "rb")
        if cur == last:
            return True
        last = cur
        time.sleep(interval)
    return False


