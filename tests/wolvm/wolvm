ANSI = re.compile(r"\x1b\[[0-9;=?]*[A-Za-z]|\x1b[()][0-9A-B]|\x1b[=>]|\r")


def serial_text(vm, since=None):
    try:
        with open(vm.p("serial.log"), "rb") as f:
            f.seek(vm.run.get("serial_offset", 0) if since is None else since)
            return ANSI.sub("", f.read().decode("utf-8", "replace"))
    except OSError:
        return ""


def wait_text(vm, text, timeout, regex=False, new=False):
    start = os.path.getsize(vm.p("serial.log")) if new and os.path.exists(vm.p("serial.log")) else None
    end = time.time() + timeout
    pat = re.compile(text) if regex else None
    while True:
        s = serial_text(vm, start)
        if (pat.search(s) if pat else text in s):
            return True, s
        if time.time() > end or not vm.pid():
            return False, s
        time.sleep(0.5)


def cmd_wait_text(a):
    vm = VM(a.home, a.name)
    if DRY:
        print(f"wait for {a.text!r} in {vm.p('serial.log')}")
        return 0
    ok, s = wait_text(vm, a.text, a.timeout, a.regex, a.new)
    if ok:
        print(f"found {a.text!r}")
        return 0
    sys.stderr.write(f"timeout after {a.timeout} s waiting for {a.text!r}" +
                     ("" if vm.pid() else " (VM stopped)") + "; serial tail:\n" + "\n".join(s.splitlines()[-25:]) + "\n")
    return 1


