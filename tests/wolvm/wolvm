def guest(vm, command, timeout=300, user="root", via="auto"):
    """Run a shell command in the guest: ssh when the VM has --ssh and sshd answers, else the agent.
    via: auto | ssh (fail rather than fall back) | agent."""
    cfg, run = vm.cfg, vm.run
    if via == "ssh" and not (cfg.get("ssh") and run.get("ssh_port")):
        raise RuntimeError("this VM was made without --ssh")
    if via != "agent" and cfg.get("ssh") and run.get("ssh_port"):
        r = subprocess.run(["ssh", "-i", vm.p("id_ed25519"), "-p", str(run["ssh_port"]), "-o", "BatchMode=yes",
                            "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
                            "-o", "ConnectTimeout=5", "-o", "LogLevel=ERROR", f"{user}@127.0.0.1", command],
                           text=True, capture_output=True, timeout=timeout)
        if r.returncode != 255 or via == "ssh":
            return r.returncode, r.stdout, r.stderr
    if user != "root":
        command = f"runuser -u {shlex.quote(user)} -- sh -c {shlex.quote(command)}"
    return vm.agent().run(command, timeout)


def cmd_ssh(a):
    vm = VM(a.home, a.name)
    command = " ".join(a.cmd)
    if DRY:
        print(json.dumps({"execute": "guest-exec", "arguments": {"path": "/bin/sh", "arg": ["-c", command],
                                                                 "capture-output": True}}))
        return 0
    try:
        rc, out, err = guest(vm, command, a.timeout, a.user, a.via)
    except (OSError, RuntimeError, TimeoutError, ValueError) as e:
        die(f"no way into the guest yet ({e}); wolvm wait-agent {vm.name}")
    sys.stdout.write(out)
    sys.stderr.write(err)
    return rc


# The WolOS image ships sshd disabled and an nftables input policy of drop (table inet wolos):
# for this boot only, start sshd and accept port 22. Nothing is written to the guest's disk.
SSH_OPEN = ("systemctl start sshd.service && "
            "{ nft list table inet wolos >/dev/null 2>&1 && nft insert rule inet wolos input tcp dport 22 accept || :; } && "
            "systemctl is-active sshd.service")


def cmd_ssh_open(a):
    vm = VM(a.home, a.name)
    if DRY:
        print(SSH_OPEN)
        return 0
    if not vm.cfg.get("ssh"):
        die(f"{vm.name} was made without --ssh (no key, no port forward)")
    rc, out, err = guest(vm, SSH_OPEN, 60, via="agent")
    if rc:
        die(f"could not open sshd: {(out + err).strip()}")
    rc, out, err = guest(vm, "true", 30, via="ssh")
    print(f"ssh up on 127.0.0.1:{vm.run.get('ssh_port')}" if rc == 0 else f"sshd started but ssh failed: {err.strip()}")
    return rc


