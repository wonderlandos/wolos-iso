def cmd_rm(a):
    vm = VM(a.home, a.name)
    if vm.pid():
        die(f"{vm.name} is running; stop it first")
    shutil.rmtree(vm.dir)
    print(f"{vm.name}: removed")
    return 0


# ---------------------------------------------------------------- journey and report
def run_step(vm, st, out_dir, idx):
    """Runs one parsed step. Returns (ok, detail)."""
    v, args, o = st["verb"], st["args"], st["opts"]
    t = float(o.get("timeout", 120))
    if v == "start":
        return cmd_start(argparse.Namespace(home=os.path.dirname(os.path.dirname(vm.dir)), name=vm.name)) == 0, ""
    if v == "stop":
        rc = cmd_stop(argparse.Namespace(home=os.path.dirname(os.path.dirname(vm.dir)), name=vm.name,
                                         force=bool(o.get("force")), timeout=t))
        return rc == 0, ""
    if v in ("shot", "screenshot"):
        return True, ""  # the runner takes the picture
    if v == "type":
        type_text(vm, args[0])
        return True, ""
    if v == "key":
        press(vm, args)
        return True, ""
    if v == "click":
        click(vm, int(args[0]), int(args[1]), o.get("button", "left"), bool(o.get("double")))
        return True, ""
    if v == "wait-text":
        ok, s = wait_text(vm, args[0], t, bool(o.get("regex")), bool(o.get("new")))
        return ok, "" if ok else "timeout; serial tail:\n" + "\n".join(s.splitlines()[-15:])
    if v == "wait-agent":
        return wait_agent(vm, t), ""
    if v == "wait-stable":
        return wait_stable(vm, t), ""
    if v == "sleep":
        time.sleep(float(args[0]))
        return True, ""
    if v in ("ssh", "exec"):
        rc, out, err = guest(vm, args[0], t, o.get("user", "root"), o.get("via", "auto"))
        text = out + err
        if o.get("save"):
            write_file(os.path.join(out_dir, os.path.basename(str(o["save"]))), text)
        want = o.get("rc", 0)
        ok = (want == "any" or rc == int(want)) and (str(o["expect"]) in text if "expect" in o else True)
        return ok, f"rc={rc}\n{text[-2000:]}"
    if v == "logs":
        text = logs(vm, int(o.get("n", 300)), o.get("unit"))
        name = f"{idx:02d}-logs.txt"
        write_file(os.path.join(out_dir, name), text)
        return True, f"saved {name} ({len(text.splitlines())} lines)"
    if v in ("checkpoint", "snapshot-save"):
        return True, snapshot(vm, "save", args[0] if args else f"step{idx}")
    if v == "snapshot-restore":
        return True, snapshot(vm, "restore", args[0])
    if v == "eject":
        vm.qmp().call({"execute": "eject", "arguments": {"id": "cd0", "force": True}})
        return True, ""
    if v == "boot":
        cfg = vm.cfg
        cfg["boot"] = args[0] if args else "disk"
        vm.save_cfg(cfg)
        return True, f"next start boots {cfg['boot']}"
    if v == "note":
        return True, args[0]
    if v == "serial-send":
        cmd_serial(argparse.Namespace(home=os.path.dirname(os.path.dirname(vm.dir)), name=vm.name,
                                      action="send", text=args[0]))
        return True, ""
    return False, f"unhandled verb {v}"


def slug(s):
    return re.sub(r"[^A-Za-z0-9]+", "-", s).strip("-")[:40] or "step"


def cmd_journey(a):
    vm = VM(a.home, a.name)
    meta, steps = load_journey(a.file)
    if DRY:
        for i, st in enumerate(steps, 1):
            print(f"{i:02d} {st['verb']} {json.dumps(st['args'])} {json.dumps(st['opts'])}")
        return 0
    vm.cfg  # exists?
    out = os.path.abspath(a.out or os.path.join(vm.dir, "journeys", time.strftime("%Y%m%d-%H%M%S")))
    os.makedirs(out, exist_ok=True)
    with open(os.path.join(out, "journey.jsonl"), "a") as jl:
        title = meta.get("name") or os.path.basename(a.file)
        jl.write(json.dumps({"journey": title, "vm": vm.name, "file": os.path.abspath(a.file), "time": time.ctime()}) + "\n")
        failed = 0
        for i, st in enumerate(steps, 1):
            if i < a.frm:
                continue
            label = " ".join([st["verb"]] + st["args"])
            t0 = time.time()
            tries = int(st["opts"].get("retry", 0)) + 1
            for attempt in range(tries):
                try:
                    ok, detail = run_step(vm, st, out, i)
                except (OSError, RuntimeError, TimeoutError, ValueError) as e:
                    ok, detail = False, f"{type(e).__name__}: {e}"
                except SystemExit as e:  # die() inside a step fails the step, not the journey
                    ok, detail = False, f"exit {e.code}"
                if ok:
                    break
                if st["opts"].get("on-fail-restore"):
                    snapshot(vm, "restore", st["opts"]["on-fail-restore"])
            shot = None
            want_shot = st["opts"].get("shot", True) and st["verb"] not in ("stop", "note", "boot", "logs")
            if want_shot and vm.pid():
                name = (st["args"][0] if st["verb"] in ("shot", "screenshot") and st["args"] else "-".join([st["verb"]] + ([slug(" ".join(st["args"]))] if st["args"] else [])))
                shot = f"{i:02d}-{slug(name)}.png"
                try:
                    screenshot(vm, os.path.join(out, shot))
                except (OSError, RuntimeError, ValueError) as e:
                    detail += f"\n(screenshot failed: {e})"
                    shot = None
            rec = {"n": i, "step": label, "opts": st["opts"], "ok": ok, "secs": round(time.time() - t0, 1),
                   "shot": shot, "detail": detail, "caption": st["opts"].get("caption", "")}
            jl.write(json.dumps(rec) + "\n")
            jl.flush()
            print(f"{'ok  ' if ok else 'FAIL'} {i:02d} {label[:70]}" + (f"  [{shot}]" if shot else ""), flush=True)
            if not ok:
                failed += 1
                if detail:
                    print("     " + detail.replace("\n", "\n     ")[:1500])
                if not a.keep_going:
                    print(f"stopped at step {i}; fix and rerun with --from {i} (snapshots: wolvm snapshot {vm.name} list)")
                    break
        shutil.copy(vm.p("serial.log"), os.path.join(out, "serial.log")) if os.path.exists(vm.p("serial.log")) else None
    write_report(out)
    print(f"{out}: {'all steps passed' if not failed else f'{failed} failed'}; report {os.path.join(out, 'index.html')}")
    return 1 if failed else 0


def write_report(d):
    recs, head = [], {}
    jp = os.path.join(d, "journey.jsonl")
    if os.path.exists(jp):
        for line in read_file(jp).splitlines():
            r = json.loads(line)
            if "journey" in r:
                head, recs = r, []  # the last run in this dir
            else:
                recs.append(r)
    else:
        for n, f in enumerate(sorted(x for x in os.listdir(d) if x.endswith(".png")), 1):
            recs.append({"n": n, "step": f, "ok": True, "shot": f, "detail": "", "caption": ""})
    texts = sorted(f for f in os.listdir(d) if f.endswith((".txt", ".log")))
    serial_tail = ""
    if os.path.exists(os.path.join(d, "serial.log")):
        serial_tail = ANSI.sub("", read_file(os.path.join(d, "serial.log"), "rb").decode("utf-8", "replace"))
        serial_tail = "\n".join(serial_tail.splitlines()[-80:])
    title = head.get("journey", os.path.basename(d.rstrip("/")))
    passed = sum(1 for r in recs if r["ok"])
    md = [f"# {title}", "", f"VM `{head.get('vm', '?')}`, {head.get('time', '')}: {passed}/{len(recs)} steps ok.", ""]
    for r in recs:
        md.append(f"## {r['n']:02d} {'ok' if r['ok'] else 'FAIL'}: `{r['step']}` ({r.get('secs', 0)} s)")
        if r.get("caption"):
            md.append(r["caption"])
        if r.get("shot"):
            md.append(f"![{r['step']}]({r['shot']})")
        if r.get("detail"):
            md += ["```", r["detail"], "```"]
        md.append("")
    md += ["## Files", ""] + [f"- [{t}]({t})" for t in texts]
    if serial_tail:
        md += ["", "## Serial (last 80 lines)", "```", serial_tail, "```"]
    write_file(os.path.join(d, "report.md"), "\n".join(md) + "\n")
    e = html.escape
    h = [f"<!doctype html><meta charset=utf-8><title>{e(title)}</title><style>body{{font:14px sans-serif;"
         "max-width:1400px;margin:2em auto;background:#111;color:#ddd}}.s{{margin:1.5em 0;padding:1em;"
         "background:#1b1b1b;border-left:4px solid #3a3}}.f{{border-color:#d33}}img{{max-width:100%;"
         "border:1px solid #333}}pre{{white-space:pre-wrap;background:#000;padding:.6em;max-height:24em;"
         "overflow:auto}}a{{color:#8cf}}</style>",
         f"<h1>{e(title)}</h1><p>VM <code>{e(head.get('vm', '?'))}</code>, {e(head.get('time', ''))}: "
         f"<b>{passed}/{len(recs)}</b> steps ok.</p>"]
    for r in recs:
        h.append(f"<div class='s{'' if r['ok'] else ' f'}'><h3>{r['n']:02d} {'ok' if r['ok'] else 'FAIL'}: "
                 f"<code>{e(r['step'])}</code> <small>{r.get('secs', 0)} s</small></h3>")
        if r.get("caption"):
            h.append(f"<p>{e(r['caption'])}</p>")
        if r.get("shot"):
            h.append(f"<a href='{e(r['shot'])}'><img src='{e(r['shot'])}' loading=lazy></a>")
        if r.get("detail"):
            h.append(f"<pre>{e(r['detail'])}</pre>")
        h.append("</div>")
    h.append("<h2>Files</h2><ul>" + "".join(f"<li><a href='{e(t)}'>{e(t)}</a></li>" for t in texts) + "</ul>")
    if serial_tail:
        h.append(f"<h2>Serial (last 80 lines)</h2><pre>{e(serial_tail)}</pre>")
    write_file(os.path.join(d, "index.html"), "\n".join(h) + "\n")
    return os.path.join(d, "index.html")


def cmd_report(a):
    print(write_report(os.path.abspath(a.dir)))
    return 0


# ---------------------------------------------------------------- doctor
def cmd_doctor(a):
    checks = []
    kvm = os.path.exists("/dev/kvm")
    checks.append(("kvm", kvm and os.access("/dev/kvm", os.R_OK | os.W_OK),
                   "/dev/kvm usable" if kvm else "no /dev/kvm: falls back to TCG (10x slower)", False))
    for tool, need, hint in (("qemu-system-x86_64", True, "pacman -S qemu-base"), ("qemu-img", True, "qemu-img"),
                             ("swtpm", False, "--tpm needs it: pacman -S swtpm"),
                             ("virt-fw-vars", False, "--secureboot needs it: pacman -S virt-firmware"),
                             ("bsdtar", False, "--direct needs it: pacman -S libarchive"),
                             ("ssh", False, "--ssh needs openssh"), ("ssh-keygen", False, "--ssh needs openssh")):
        p = shutil.which(tool)
        checks.append((tool, bool(p), p or hint, need))
    for label, names, need in (("ovmf-code", FW_CODE, True), ("ovmf-code-secboot", FW_CODE_SB, False),
                               ("ovmf-vars", FW_VARS, True)):
        p = find_fw(names)
        checks.append((label, bool(p), p or "pacman -S edk2-ovmf (or WOLVM_OVMF=dir)", need))
    if shutil.which("qemu-system-x86_64"):
        v = subprocess.run(["qemu-system-x86_64", "--version"], text=True, capture_output=True).stdout.split("\n")[0]
        checks.append(("qemu-version", True, v, False))
    checks.append(("home", True, a.home, False))
    bad = 0
    for name, ok, info, need in checks:
        print(f"{'ok  ' if ok else ('MISS' if need else 'warn')} {name:18} {info}")
        bad += (not ok and need)
    return 1 if bad else 0


# ---------------------------------------------------------------- CLI
def parser():
    ap = argparse.ArgumentParser(prog="wolvm", description="Drive a QEMU test VM step by step (see tests/README-wolvm.md).")
    ap.add_argument("--home", default=os.environ.get("WOLVM_HOME", HOME_DEFAULT))
    ap.add_argument("--dry-run", action="store_true", help="print the qemu command / QMP JSON, run nothing")
    sp = ap.add_subparsers(dest="cmd", required=True)
    sp.add_parser("doctor").set_defaults(fn=cmd_doctor)
    n = sp.add_parser("new")
    n.add_argument("name"); n.add_argument("--iso"); n.add_argument("--disk", default="40G")
    n.add_argument("--mem", default="6G"); n.add_argument("--smp", type=int, default=4)
    n.add_argument("--tpm", action="store_true"); n.add_argument("--secureboot", action="store_true")
    n.add_argument("--gpu", choices=sorted(GPUS), default="virtio")
    n.add_argument("--vmsvga", action="store_true"); n.add_argument("--virtio", action="store_true")
    n.add_argument("--res", default="1280x800"); n.add_argument("--ssh", action="store_true")
    n.add_argument("--direct", action="store_true", help="boot the ISO's kernel directly (cmdline under our control)")
    n.add_argument("--append", help="extra kernel cmdline (e.g. wolos.try)")
    n.add_argument("--cred", action="append", help="systemd credential NAME=VALUE via SMBIOS")
    n.add_argument("--vnc", help="e.g. unix:/path/vnc.sock or 127.0.0.1:5 for a person to watch")
    n.add_argument("--no-console", action="store_true", help="do not add console=ttyS0")
    n.add_argument("--drive", action="append", metavar="FILE[,ro|,snapshot]",
                   help="an extra raw virtio disk (/dev/vdb, vdc... in order), bytes untouched by wolvm")
    n.add_argument("--no-net", action="store_true", help="no network card (offline install)")
    n.add_argument("--iso-bus", choices=["ide", "virtio"], default="ide",
                   help="virtio: the ISO as a writable throwaway disk (snapshot=on), like a USB stick")
    n.add_argument("--from-image", help="start from a copy of this raw/qcow2 disk instead of an empty one")
    n.add_argument("--force", action="store_true"); n.set_defaults(fn=cmd_new)
    for name, fn in (("start", cmd_start), ("status", cmd_status), ("rm", cmd_rm), ("eject", cmd_eject)):
        s = sp.add_parser(name); s.add_argument("name"); s.set_defaults(fn=fn)
    sp.add_parser("list").set_defaults(fn=cmd_list)
    s = sp.add_parser("stop"); s.add_argument("name"); s.add_argument("--force", action="store_true")
    s.add_argument("--timeout", type=float, default=60); s.set_defaults(fn=cmd_stop)
    s = sp.add_parser("set"); s.add_argument("name"); s.add_argument("--boot", choices=["disk", "cdrom"])
    s.add_argument("--iso"); s.add_argument("--no-iso", action="store_true"); s.add_argument("--append")
    s.add_argument("--mem"); s.add_argument("--gpu", choices=sorted(GPUS)); s.add_argument("--res"); s.add_argument("--vnc")
    s.add_argument("--secureboot", choices=["on", "off"], help="SecureBootEnable in the vars (VM made with --secureboot, stopped)")
    s.add_argument("--net", choices=["on", "off"])
    s.set_defaults(fn=cmd_set)
    s = sp.add_parser("screenshot", aliases=["shot"]); s.add_argument("name"); s.add_argument("out")
    s.add_argument("--no-nudge", action="store_true", help="do not wiggle the pointer to force a repaint")
    s.set_defaults(fn=cmd_screenshot)
    s = sp.add_parser("wait-stable"); s.add_argument("name"); s.add_argument("--timeout", type=float, default=60)
    s.set_defaults(fn=cmd_wait_stable)
    s = sp.add_parser("type"); s.add_argument("name"); s.add_argument("text")
    s.add_argument("-e", "--escapes", action="store_true", help="read \\n \\t in TEXT"); s.set_defaults(fn=cmd_type)
    s = sp.add_parser("key"); s.add_argument("name"); s.add_argument("combo", nargs="+"); s.set_defaults(fn=cmd_key)
    s = sp.add_parser("click"); s.add_argument("name"); s.add_argument("x", type=int); s.add_argument("y", type=int)
    s.add_argument("--button", default="left", choices=["left", "right", "middle"])
    s.add_argument("--double", action="store_true"); s.set_defaults(fn=cmd_click)
    s = sp.add_parser("serial"); s.add_argument("name"); s.add_argument("action", choices=["tail", "send"])
    s.add_argument("text", nargs="?", default=""); s.add_argument("-n", type=int, default=40)
    s.add_argument("--all", action="store_true", help="tail across earlier boots too"); s.set_defaults(fn=cmd_serial)
    s = sp.add_parser("wait-text"); s.add_argument("name"); s.add_argument("text")
    s.add_argument("--timeout", type=float, default=120); s.add_argument("--regex", action="store_true")
    s.add_argument("--new", action="store_true", help="only text that arrives from now on"); s.set_defaults(fn=cmd_wait_text)
    s = sp.add_parser("wait-agent"); s.add_argument("name"); s.add_argument("--timeout", type=float, default=300)
    s.set_defaults(fn=cmd_wait_agent)
    s = sp.add_parser("ssh", aliases=["exec"]); s.add_argument("name"); s.add_argument("cmd", nargs="+")
    s.add_argument("--timeout", type=float, default=300); s.add_argument("--user", default="root")
    s.add_argument("--via", choices=["auto", "ssh", "agent"], default="auto"); s.set_defaults(fn=cmd_ssh)
    s = sp.add_parser("ssh-open"); s.add_argument("name"); s.set_defaults(fn=cmd_ssh_open)
    s = sp.add_parser("logs"); s.add_argument("name"); s.add_argument("-n", type=int, default=300)
    s.add_argument("-u", "--unit"); s.add_argument("-o", "--out"); s.set_defaults(fn=cmd_logs)
    s = sp.add_parser("snapshot"); s.add_argument("name"); s.add_argument("action", choices=["save", "restore", "list", "delete"])
    s.add_argument("tag", nargs="?"); s.set_defaults(fn=cmd_snapshot)
    s = sp.add_parser("journey"); s.add_argument("name"); s.add_argument("file"); s.add_argument("--out")
    s.add_argument("--from", dest="frm", type=int, default=1); s.add_argument("--keep-going", action="store_true")
    s.set_defaults(fn=cmd_journey)
    s = sp.add_parser("report"); s.add_argument("dir"); s.set_defaults(fn=cmd_report)
    return ap


def main(argv=None):
    global DRY
    a = parser().parse_args(argv)
    DRY = a.dry_run
    try:
        return a.fn(a) or 0
    except ValueError as e:
        die(str(e), 2)
    except (RuntimeError, OSError, TimeoutError) as e:
        die(str(e))


if __name__ == "__main__":
    sys.exit(main())
