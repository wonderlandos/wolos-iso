# WolOS desktop runtime packages (Arch names at the snapshot in profile/snapshot). One per line.
# Base system, kernel, firmware, networking: profile/packages.x86_64. build.sh merges both.
# WolOS itself: wol daemons, shell, overlay, plugins (built into [wolos] by wolos-build/wolos-build).
wolos-system
# Graphics / session: the WolOS Hyprland fork (patches in wolos-pkgbuilds/hyprland-wolos), Mesa, Vulkan, VA-API.
hyprland-wolos
hypridle
hyprsunset # Night Light (wol_core::toggles, Ctrl+Super+N, Control Center): hyprland.conf exec-once starts it, hyprctl hyprsunset tints
xdg-desktop-portal-hyprland
xorg-xwayland
xorg-xrdb # wol-x11-env + Settings cursor size (wol_core::hyprprefs::cursor_sync): Xft.dpi, Xcursor.*
xorg-xhost # hyprland.conf exec-once: only this account's X11 clients may connect to Xwayland
mesa
lib32-mesa
vulkan-intel             # anv: Vulkan for DXVK/Proton on Intel
lib32-vulkan-intel
vulkan-radeon            # RADV
lib32-vulkan-radeon
vulkan-icd-loader
lib32-vulkan-icd-loader
intel-media-driver       # VA-API iHD (Gen8+): the browser/mpv GPU decode; LIBVA_DRIVER_NAME=iHD from wol-session
# NVIDIA: nvidia-open-dkms + nvidia-utils are installed by `wol hw boot --online` when an NVIDIA GPU is
# present (DKMS builds against linux-wolos-headers).
# GPU proof tools (wolos/files/usr/lib/wolos/verify-gpu.sh)
mesa-utils
vulkan-tools
libva-utils
glmark2
vkmark
libinput
seatd
xkeyboard-config
# Shell runtime (wol-shell)
gtk4
gtk4-layer-shell
libadwaita
librsvg
gsettings-desktop-schemas
dconf
# Audio
pipewire
pipewire-pulse
pipewire-alsa
pipewire-jack
pipewire-v4l2
pipewire-libcamera
gst-plugin-pipewire
lib32-pipewire
wireplumber
noise-suppression-for-voice   # RNNoise LADSPA plugin: Settings > Sound "Reduce background noise" (loaded on demand)
playerctl
# Wayland tools used by keybinds
grim
slurp
wf-recorder
wl-clipboard
libnotify
# Portals / auth / themes / fonts
archlinux-appstream-data
flatpak
xdg-desktop-portal
xdg-desktop-portal-gtk
lxqt-policykit
adwaita-icon-theme
qt6ct
kvantum                  # Qt style: WolOS theme generated by `wol theme` (qt6ct style=kvantum)
adw-gtk-theme            # GTK3 apps in the libadwaita look
inter-font               # WolOS type system
ttf-jetbrains-mono
otf-font-awesome
noto-fonts               # Latin, Greek, Cyrillic, Arabic, Hebrew, Devanagari, Thai...
noto-fonts-emoji
noto-fonts-cjk           # Chinese, Japanese, Korean: the language picker and the terminal (70-wolos-cjk-arabic.conf)
# Apps
atlas-browser
nautilus
foot
gnome-text-editor
eog                      # Image Viewer: the fallback viewer, default for GIF, WebP and SVG (Atlas second; E2E-SET)
wolos-app-gallery        # Gallery: Photos pin and the default for PNG and JPEG (E2E-SET; libwolkit + libwol come with it)
# System web apps (ADR 0048, QA-WEB-1): Doctor and the kit run on the engine library; the two enter together
# (checks/tests/image_web_apps.rs) with the engine's installed size in profile/web-engine-size. The image has
# no size limit (ISO-GATE, lead 2026-11-04).
wolos-webapps
webengine-wolos
# Spell check (E2E-SET, ADR 0059 S14): enchant is the backend of libspelling (Text Editor, Papers, Geary), the
# dictionaries are the languages of region::LANGUAGES that have one (Japanese and Chinese have no word list).
enchant
hunspell
hunspell-en_us
hunspell-en_gb
hunspell-es_es
hunspell-fr-comprehensive
hunspell-de
hunspell-it
hunspell-nl
hunspell-pl
wolos-spell-pt           # Portuguese (Brazil, Portugal): Arch has no hunspell-pt, the recipe packs the LibreOffice word lists
# System tools of the experience (E2E-SET): the colour picker (Ctrl+Super+P) and the PDF tools Quick Look and
# Documents call (pdftocairo, pdftotext, pdftoppm; the library comes with papers anyway).
hyprpicker
poppler
# Screen reader (ACC-1, S18): Orca, its speech service and the espeak-ng voice (brltty pulls espeak-ng anyway).
orca
speech-dispatcher
espeak-ng
# Dock apps (WolOS names + icons: crates/shell/src/apps.rs PINS, tests/pins_installed.rs)
geary                    # Mail
amberol                  # Music
gnome-calendar           # Calendar
gnote                    # Notes
gnome-calculator
gnome-clocks
papers                   # PDF
celluloid                # Videos (mpv)
mpv
file-roller
baobab
# Games (wolos/docs/modules/games.md): native Steam (multilib) and Wine for Windows programs.
steam
umu-launcher
gamescope # Steam's gamescope launch option, fixed-resolution games (Memory Saver lists it)
gamemode               # games can run through gamemoderun
lib32-gamemode
rtkit                  # realtime audio threads (PipeWire)
# Energy Mode, Low/High Power Mode, `wol power apply`: wol_core::power::policy runs powerprofilesctl
# (on through wolos-system's 51-wolos-image.preset).
power-profiles-daemon
thermald                # Intel's cooling helper (DPTF): holds temperatures before the fan or the throttle; enabled by wolos-system's preset; ends cleanly (SuccessExitStatus=2) on a CPU it does not know, and not in VMs
fprintd                 # fingerprint readers (libfprint); D-Bus activated, nothing runs without a reader; PAM is not touched
bolt                    # Thunderbolt/USB4 device authorisation (boltd, D-Bus activated)
# Terminal: zsh for every account (/etc/zsh/zshenv), sudo for wheel (sudoers.d/wolos)
zsh-autosuggestions
zsh-syntax-highlighting
zsh-completions
# Scripts: sh and zsh from the base; ruby for .rb scripts and rsh (Ruby with a shell layer, its own
# interpreter built in) for .rsh scripts and as a terminal shell (wolos ADR 0041, wol script).
ruby
ruby-stdlib              # the whole standard library: default and bundled gems (irb, bundler, rake, minitest...), about 4 MB
rsh
# Session: xdg-user-dirs at login (wol-session), login keyring unlocked by wol-login
xdg-user-dirs
gnome-keyring
# Printing: cups + avahi (driverless IPP printers)
cups
cups-filters
avahi
nss-mdns                 # .local names: wolos-system puts mdns_minimal before resolve in /etc/nsswitch.conf
# Removable media: udisks2 (mounts under /run/media/<user>), gvfs for Files, NTFS and exFAT.
udisks2
gvfs
gvfs-mtp                 # Android phones (MTP)
gvfs-gphoto2             # cameras (PTP)
gvfs-smb                 # Windows and Samba shares
# iPhone and iPad: photos (HEIC) and files in Files, USB internet sharing, pairing.
usbmuxd
libimobiledevice
ifuse
gvfs-afc
libheif
# Bluetooth headphones: AAC, LDAC and aptX codecs for PipeWire.
pipewire-audio
# AirPlay speakers as sound outputs.
pipewire-zeroconf
shairport-sync           # AirPlay audio receiver into PipeWire
ntfs-3g
exfatprogs
