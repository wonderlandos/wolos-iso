# WolOS live + installed system. The desktop list is profile/packages.desktop; build.sh merges both.
# wolos-base (ADR 0017, [wolos]): Arch base + linux-wolos (+ headers for DKMS such as nvidia-open-dkms)
# + uutils coreutils, sudo-rs, bsdtar, zsh, systemd and the wol tools, at one release version.
wolos-keyring
wolos-base
wolos-mirrorlist
# wopkg: apps from every source, one command (ADR 0021).
wopkg
# The QoS scheduler on sched_ext (scx_wolos.service; EEVDF whenever it is not attached).
scx-wolos
linux-firmware
intel-ucode
amd-ucode
sof-firmware
mkinitcpio
mkinitcpio-archiso
plymouth
# Installer and A/B slots: systemd-repart and systemd-boot (in systemd), the file systems a layout
# can format or resize, unsquash of the live root.
arch-install-scripts
btrfs-progs
cryptsetup
fsverity-utils
dosfstools
e2fsprogs
xfsprogs
ntfsprogs
squashfs-tools
efibootmgr
# Signed boot images and this computer's boot keys.
systemd-ukify
sbctl
mokutil
wolos-shim
pacman-contrib
# Hardware and networking.
networkmanager
iwd
# sshd: never on by default; the live medium starts it only with the credential
# ssh.authorized_keys.root (airootfs sshd.service.d/wolos-live.conf; VM tests, wolvm --ssh).
openssh
wireless-regdb
bluez
bluez-utils
nftables
pciutils
usbutils
# Firmware updates from the vendors (LVFS): fwupdmgr, the Doctor and Settings > Updates; the
# metadata download stays off until the person turns it on (wolos-system 51-wolos-image.preset).
fwupd
dkms
# Swap in compressed RAM (usr/lib/systemd/zram-generator.conf).
zram-generator
less
man-db
# Guest support in virtual machines, each started only under its own hypervisor
# (ConditionVirtualization in the units, systemd-detect-virt in the session): VirtualBox resize
# and clipboard (VBoxService + VBoxDRMClient; wol-vbox-guest starts VBoxClient resize, clipboard, drag and drop), VMware tools, SPICE agent, QEMU guest agent.
virtualbox-guest-utils
open-vm-tools
spice-vdagent
qemu-guest-agent
